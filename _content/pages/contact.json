  "description": "Contact Soheil Zarrinpour.",
  "body": "<p>For inquiries about compositions or collaborations, please reach out via email.</p>\n\n<p>Email: <a href=\"mailto:zarrinpour.s@gmail.com\">zarrinpour.s@gmail.com</a></p>\n\n<h2>Send a Message</h2>\n\n<form action=\"https://api.web3forms.com/submit\" method=\"POST\" class=\"contact-form\">\n<input type=\"hidden\" name=\"access_key\" value=\"b229b9bc-af90-4d78-be59-cf472062c208\">\n<input type=\"hidden\" name=\"redirect\" value=\"https://soheilzarrinpour.com/pages/contact.html\">\n<div class=\"form-group\">\n<label for=\"name\">Name</label>\n<input type=\"text\" id=\"name\" name=\"name\" required>\n</div>\n<div class=\"form-group\">\n<label for=\"email\">Email</label>\n<input type=\"email\" id=\"email\" name=\"email\" required>\n</div>\n<div class=\"form-group\">\n<label for=\"subject\">Subject</label>\n<input type=\"text\" id=\"subject\" name=\"subject\" required>\n</div>\n<div class=\"form-group\">\n<label for=\"message\">Message</label>\n<textarea id=\"message\" name=\"message\" rows=\"6\" required></textarea>\n</div>\n<input type=\"checkbox\" name=\"botcheck\" style=\"display:none\">\n<button type=\"submit\" class=\"send-button\">Send</button>\n</form>"
}
