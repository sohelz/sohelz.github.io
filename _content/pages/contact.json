{
  "title": "Contact",
  "slug": "contact",
  "description": "Contact Soheil Zarrinpour.",
  "body": "<p>For inquiries about compositions, collaborations, or research, please reach out via email.</p>\n\n<p>Email: <a href=\"mailto:zarrinpour.s@gmail.com\">zarrinpour.s@gmail.com</a></p>\n\n<h2>Send a Message</h2>\n\n<form action=\"https://formsubmit.co/zarrinpour.s@gmail.com\" method=\"POST\" class=\"contact-form\">\n<input type=\"hidden\" name=\"_subject\" value=\"New message from soheilzarrinpour.com\">\n<input type=\"hidden\" name=\"_next\" value=\"https://soheilzarrinpour.com/pages/contact.html\">\n<div class=\"form-group\">\n<label for=\"name\">Name</label>\n<input type=\"text\" id=\"name\" name=\"name\" required>\n</div>\n<div class=\"form-group\">\n<label for=\"email\">Email</label>\n<input type=\"email\" id=\"email\" name=\"email\" required>\n</div>\n<div class=\"form-group\">\n<label for=\"subject\">Subject</label>\n<input type=\"text\" id=\"subject\" name=\"_subject\" required>\n</div>\n<div class=\"form-group\">\n<label for=\"message\">Message</label>\n<textarea id=\"message\" name=\"message\" rows=\"6\" required></textarea>\n</div>\n<button type=\"submit\" class=\"send-button\">Send</button>\n</form>"
}
